        (
            id: 2879,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/32-in-1-game-cartridge",
            ],
            note: "missingno does not switch between the cartridge\'s 32 games. On hardware the game is selected by power-cycling the console: a CD4024 counter in the cart is clocked by the falling edge of Vcc, its low 5 bits selecting the 2 KB bank. The VCS core (board F0) does not advance the bank on power-cycle. See the entry\'s linked references.",
        ),
        (
            id: 2881,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/artillery-duel",
            ],
            note: "In missingno, Artillery Duel produces no sound and its on-screen barrel/powder/wind readouts do not update as they should. Confirmed across all NTSC and PAL dumps, so it is not a tv_format/timing artefact.",
        ),
        (
            id: 2882,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/berenstain-bears",
            ],
            note: "Requires the Coleco Kid Vid Voice Module (an audio-cassette peripheral), which missingno does not emulate. Without it the game cannot play as intended. Same limitation affects the other Kid Vid titles (Smurfs Save the Day, Tooth Protectors).",
        ),
        (
            id: 2885,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/bionic-breakthrough",
            ],
            note: "Requires the Atari MindLink controller (a forehead-muscle headband), which missingno does not emulate; the game is not playable. Unreleased prototype.",
        ),
        (
            id: 2887,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/bump-n-jump",
            ],
            note: "NTSC (M Network) release only: it\'s the 8K variant of the E7 (M-Network) mapper (Stella auto-detects E7; ROM 8192 bytes), and missingno doesn\'t load it — E7 shows no picture, forcing F8/F8SC boots then freezes on the first E7 bank/RAM access. Looks like missingno\'s E7 support misses the 8K E7 variant. The Telegames PAL release is a different board (standard F8) and plays fine, so the game is reachable via that dump; the gap is specifically 8K E7 carts.",
        ),
        (
            id: 2888,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/atari-video-cube",
            ],
            note: "The Atari Anthology dump (ac141bb18cacc5d197ff4f9b5bef18683c989474, labelled \"Atari Anthology\" in the USA/NTSC release) renders with severe flashing and looks broken in missingno. The retail NTSC dump (d1563c24) renders correctly.",
        ),
        (
            id: 2889,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/burgertime",
            ],
            note: "The PROPER 12K fan re-dump (54a44dc9b2145f40bb7398e7d031ea4c8d091afe, 12288 bytes) fails to load in missingno: \"failed to construct console from media\". The retail 16K E7 dumps load and play.",
        ),
        (
            id: 2904,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/indy-500",
            ],
            note: "Requires the Atari Driving Controller, which missingno does not emulate. The game plays with a joystick, but the car\'s steering range is limited and it cannot be turned far.",
        ),
        (
            id: 2906,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/mind-maze",
            ],
            note: "Renders a repeating 29-scanline frame instead of a full field, on every 8K board tried. Documented elsewhere as playable.",
        ),
        (
            id: 2907,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/mission-survive",
            ],
            note: "Game never starts: sprites animate in place, but neither RESET nor the joystick begins play.",
        ),
        (
            id: 2908,
            kind: EmulationIncompatibility,
            subject: [
                "vcs/omega-race",
            ],
            note: "Needs the Booster-Grip, which the core does not model; its trigger fires the laser cannon, so a plain joystick cannot shoot.",
        ),
        (
