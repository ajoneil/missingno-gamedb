(
    title: "Pesco",
    developer: Some("Eric Bacher, Igor Barzilai"),
    description: Some("Pesco the fish clears each maze by eating every scrap of plankton while three crabs hunt him through the same waters; four glowing clumps let him turn and eat the crabs for a moment, and seaweed, shellfish and starfish drift past for extra points. The maze never changes across the nine levels — the crabs simply get faster and stay edible for less time."),
    links: [
        (
            name: "Atari Gaming Headquarters review",
            url: "http://atarihq.com/mainsite/agh-review-pesco-atari-2600/",
            link_type: Community,
        ),
        (
            name: "AtariAge Store",
            url: "https://store.atariage.com/products/pesco-atari-2600",
            link_type: Store,
        ),
    ],
