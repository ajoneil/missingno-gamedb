            sources: [
                HomebrewHub(
                    slug: "atchafalaya-arcade",
                    filename: "atchafalaya.gb",
                ),
                Itch(
                    url: "https://tambalaya.itch.io/atchafalaya-arcade",
                ),
            ],
        ),
    ],
